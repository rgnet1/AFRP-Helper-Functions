
# Dynamics CRM OAuth Configuration
# These credentials are required for Badge Generator V2 to pull data from Dynamics CRM
# To obtain these values:
# 1. Register an app in Azure AD (https://portal.azure.com)
# 2. Grant API permissions for Dynamics CRM
# 3. Create a client secret
# 4. Copy the values below

DROPBOX_CLIENT_ID=xxxxxxxxxx
DROPBOX_CLIENT_SECRET=xxxxxxxxxx

# -----------------------------------------------------------------------------
# Magazine run notifications (scheduled download / upload checks)
# -----------------------------------------------------------------------------
# Legacy PHONE_NUMBER and Verizon vtext (@vtext.com) SMS are removed.
#
# NOTIFY_CHANNELS — comma-separated channels (names are case-insensitive):
#   ntfy, telegram, discord, email
# Example using multiple channels:
#   NOTIFY_CHANNELS=ntfy,telegram,discord
#
# Set only the variables for channels you enable. Missing settings raise an error
# when the magazine job tries to send (the job itself still completes).
# -----------------------------------------------------------------------------

NOTIFY_CHANNELS=ntfy

# ntfy — required when NOTIFY_CHANNELS includes ntfy
# Install https://ntfy.sh/app and subscribe to NTFY_TOPIC (pick a long random name).
NTFY_TOPIC=afrp-magazine-change-me-to-a-long-random-string
# Public server default; set to your own ntfy base URL if self-hosting.
NTFY_SERVER=https://ntfy.sh

# Telegram — required when NOTIFY_CHANNELS includes telegram
# Create bot via @BotFather; message the bot; read chat id from getUpdates.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_CHAT_IDS=123456789,-987654321

# Discord — required when NOTIFY_CHANNELS includes discord
# Channel → Integrations → Webhooks → New Webhook → copy webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/ExampleWebhookToken

# Email — required when NOTIFY_CHANNELS includes email
# Gmail: use an App Password (not your normal login password).
# NOTIFY_EMAILS: comma-separated inboxes (real email, not carrier SMS gateways).
EMAIL=alerts@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFY_EMAILS=me@example.com,other@example.com

# Azure AD app registration credentials
AZURE_CLIENT_ID=xxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxx
AZURE_TENANT_ID=xxxxxxxxx

# Sharepoint ID
SHAREPOINT_SITE_ID=xxxxxxxx
SHAREPOINT_LIBRARY_NAME=Hathihe Ramallah Archive
SHAREPONT_DRIVE_ID=xxxxxxxxx

# Backup Server
SERVER_PASSWORD=xxxxxxxxxx


# Your Azure AD Tenant ID
DYNAMICS_TENANT_ID=xxxxxxxx

# Your Azure AD Application (Client) ID
DYNAMICS_CLIENT_ID=xxxxxxxxxxx

# Your Azure AD Client Secret
DYNAMICS_CLIENT_SECRET=xxxxxxxxx

# Your Dynamics CRM URL (do not change unless using different instance)
DYNAMICS_CRM_URL=https://xxxxx.crm.dynamics.com

# AFRP logo for badges
AFRP_LOGO_PATH=static/afrp_logo.png

SECRET_KEY=xxxxxxxxx
